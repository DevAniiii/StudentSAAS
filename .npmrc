# npm 11 script approval — the packages below ship postinstall build steps.
allow-scripts[]=prisma
allow-scripts[]=@prisma/client
allow-scripts[]=@prisma/engines
allow-scripts[]=@prisma/engines-version
allow-scripts[]=esbuild
allow-scripts[]=@swc/core
allow-scripts[]=sharp

# Deterministic, quieter installs
fund=false
audit=false
